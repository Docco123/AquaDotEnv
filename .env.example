# Server-side only (read by src/app/api/explain+api.ts). Never prefix these with EXPO_PUBLIC_.
# No secret is stored in the repo: auth comes from `gcloud auth application-default login`
# (Application Default Credentials in ~/.config/gcloud). Restart the dev server after editing.

# Google Cloud project billed for Vertex AI calls (aliases: GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# gemini-2.5-flash retires on Vertex AI on 2026-10-20. Newer: gemini-3.5-flash-lite (use VERTEX_LOCATION=global).
VERTEX_MODEL=gemini-2.5-flash

# Optional alternatives (checked in this order):
# 1. Vertex AI express-mode API key (falls back to the Gemini API if Vertex rejects the key)
VERTEX_API_KEY=
# 2. Service-account key file, or its JSON inline for hosted deploys (otherwise gcloud ADC is used)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
# 3. Gemini Developer API key (AI Studio)
GEMINI_API_KEY=
